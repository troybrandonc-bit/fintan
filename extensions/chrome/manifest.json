{
  "manifest_version": 3,
  "name": "Teach Fintan",
  "version": "1.0.0",
  "description": "Send the page you are reading to your own Fintan model to learn. It goes only to your Fintan, never anywhere else.",
  "action": { "default_popup": "popup.html", "default_title": "Teach Fintan this page" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "icons": { "128": "icon128.png" }
}
